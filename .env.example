# MongoDB connection string (Atlas in production). Include the database name.
MONGODB_URI=mongodb://127.0.0.1:27017/hearthly_dev
# Public URL of the app (Render sets RENDER_EXTERNAL_URL; the Docker image falls back to it)
NEXTAUTH_URL=http://localhost:3005
# Session encryption secret: `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me
# Optional dedicated secrets (fall back to NEXTAUTH_SECRET when unset)
WIDGET_TOKEN_SECRET=
WEBHOOK_SIGNING_SECRET=
# Optional SMTP for transcripts / email campaigns / invites, e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_FROM="Hearthly <no-reply@example.com>"
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Allow webhooks to private/loopback IPs — ONLY for local testing
ALLOW_PRIVATE_URLS=false
